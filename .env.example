PAIKKATIETO_API_KEY=
# Server-only Digitransit subscription key. Never prefix with VITE_.
DIGITRANSIT_API_KEY=
# Optional compatible MapLibre style; defaults to OpenFreeMap Positron.
# A style on another host must also be added to the CSP in vercel.json.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
