{
  "name": "helsinki-sports-map",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4180",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:data": "node tools/check-study-area.mjs",
    "check:expanded-map": "node tools/check-expanded-map.mjs",
    "check:venues": "node tools/check-venue-data.mjs",
    "check:service-map": "node tools/check-service-map.mjs",
    "check:lipas": "node tools/check-lipas-data.mjs",
    "check:lipas:classification": "node tools/check-lipas-classification.mjs",
    "data:lipas": "node tools/import-lipas.mjs",
    "data:service-map": "node tools/import-service-map.mjs",
    "check:landmarks": "node tools/check-landmarks.mjs",
    "data:split-map": "node tools/split-map-data.mjs --source src/data/central-helsinki.json --output src/data/map-chunks/central-helsinki"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
